rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is boss (patron). Boss artık admin-eşi
    // tam yetkiye sahiptir: monitoring verisini okur VE admin'in yazabildiği
    // her koleksiyona yazabilir (kullanıcı kararı — eski salt-okunur tasarım
    // bilinçli olarak terk edildi).
    function isBoss() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'boss';
    }

    // Admin or boss — used to grant the monitoring read access boss needs.
    function isAdminOrBoss() {
      return isAdmin() || isBoss();
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ---------------------------------------------------------------------
    // USERS — yetki alanları yalnız admin/boss'ta
    //
    // isAdmin()/isBoss() rolü kullanıcının KENDİ belgesinden okur. Eskiden
    // kullanıcı kendi belgesine serbestçe yazabildiği için öğrenci
    // `role: 'admin'` yazıp tüm admin kurallarını (ve rolü Firestore'dan
    // doğrulayan Cloud Function'ları) kendine açabiliyordu. Artık kullanıcı
    // kendi belgesinde yalnız profil alanlarını değiştirebilir; role, status,
    // deleted, phone_number, membershipType, groupAssignment, groupSchedule,
    // level, balance ve diğer tüm alanlar admin/boss işidir.
    // ---------------------------------------------------------------------

    // Kayıt (store register + AuthService.createUserDocument): yalnız
    // onay bekleyen öğrenci. `id` alanı yazılırsa belge kimliğiyle aynı olmalı
    // (alanın doküman kimliğini gölgelemesi tuzağı).
    function isValidSelfRegistration(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'phone_number', 'firstName', 'lastName',
                               'role', 'status', 'email', 'birthDate', 'level',
                               'phone', 'address', 'emergencyContact',
                               'createdAt', 'updatedAt', 'lastLoginAt']) &&
        d.get('role', null) == 'student' &&
        d.get('status', null) == 'pending' &&
        d.get('id', userId) == userId;
    }

    // Kendi belgesinde değişebilecek alanlar: profil formu
    // (AuthService.updateProfile), son giriş zamanı ve zorunlu şifre
    // değişikliği bayrağının KALDIRILMASI (clearMustResetPassword).
    function isAllowedSelfUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['firstName', 'lastName', 'phone', 'email',
                              'birthDate', 'address', 'emergencyContact',
                              'updatedAt', 'lastLoginAt', 'mustResetPassword']) &&
        (!('mustResetPassword' in changed) ||
         request.resource.data.mustResetPassword == false);
    }

    // Boss admin-eşidir (bkz. isBoss) — okur ve yazar.
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdminOrBoss());

      allow create: if request.auth != null &&
        ((request.auth.uid == userId && isValidSelfRegistration(userId)) ||
         isAdminOrBoss());

      allow update: if request.auth != null &&
        ((request.auth.uid == userId && isAllowedSelfUpdate()) ||
         isAdminOrBoss());

      // Öğrenci silme/reddi admin işidir; kullanıcı kendi belgesini silemez
      // (silip bekleyen öğrenci olarak yeniden oluşturarak "silindi" durumundan
      // kaçamasın).
      allow delete: if isAdminOrBoss();
    }

    // Courts collection - allow authenticated users to read
    match /courts/{courtId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrBoss();
    }
    
    // Court Schedule collection
    match /courtSchedule/{scheduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Periyodik kort kapatma kuralları ("her X günü bakım/kapalı").
    // Öğrenci takvimi/rezervasyon formu da okuduğundan read tüm girişliler,
    // write yalnız admin/boss.
    match /recurringCourtBlocks/{blockId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrBoss();
    }
    
    // ---------------------------------------------------------------------
    // GÜNDE-BİR KORT REZERVASYONU (sunucu zorlaması)
    //
    // Öğrenci aynı gün için en fazla BİR aktif (pending/confirmed) kort
    // kiralaması tutabilir; dersler sayılmaz. Kurallar sorgu/sayım
    // yapamadığından benzersizlik reservationDayLocks/{studentId}_{YYYY-MM-DD}
    // kilidiyle sağlanır: öğrenci rezervasyonu ve kilidi AYNI batch'te yazar
    // (src/services/reservationDayLock.ts). Kilit başka bir aktif
    // rezervasyonu gösteriyorsa kilit yazımı (update) reddedilir ve batch
    // bütünüyle düşer. Kilidin gösterdiği kayıt iptal/tamamlandı/silindiyse
    // kilit devralınır — iptal akışlarının kilide dokunması gerekmez.
    // ---------------------------------------------------------------------

    function isValidDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 'YYYY-MM-DD' → o günün UTC gece yarısı (istemci: dateKeyToUtcDate).
    function utcMidnightOf(key) {
      return timestamp.date(int(key.split('-')[0]),
                            int(key.split('-')[1]),
                            int(key.split('-')[2]));
    }

    function reservationPath(id) {
      return /databases/$(database)/documents/reservations/$(id);
    }

    function dayLockPath(lockId) {
      return /databases/$(database)/documents/reservationDayLocks/$(lockId);
    }

    function isReservationOwner() {
      return resource.data.get('studentId', null) == request.auth.uid ||
             resource.data.get('userId', null) == request.auth.uid;
    }

    // Öğrencinin kendi adına açtığı, onay bekleyen kort kiralaması. Alan
    // listesi ReservationForm.vue'nun yazdığıyla birebir; tarih dateKey'e
    // bağlı; aynı batch'te o günün kilidi BU rezervasyonu göstermeli.
    function isOwnLockedCourtRental(reservationId) {
      let d = request.resource.data;
      let lockId = request.auth.uid + '_' + d.get('dateKey', '');
      return d.get('studentId', null) == request.auth.uid &&
        d.keys().hasOnly(['studentId', 'courtId', 'courtName', 'date', 'dateKey',
                          'startTime', 'endTime', 'duration', 'type', 'status',
                          'totalCost', 'createdAt']) &&
        d.get('status', null) == 'pending' &&
        d.get('type', null) == 'court-rental' &&
        isValidDateKey(d.get('dateKey', null)) &&
        d.get('date', null) == utcMidnightOf(d.dateKey) &&
        existsAfter(dayLockPath(lockId)) &&
        getAfter(dayLockPath(lockId)).data.get('reservationId', null) == reservationId;
    }

    // StudentDashboard self-heal'i (createFutureGroupReservations) öğrencinin
    // KENDİ grubunun ders kayıtlarını yeniden üretir. Dersler günde-bir
    // limitine sayılmaz; yalnız kendi groupAssignment'ı için izinli.
    function isOwnGroupLessonSelfHeal() {
      let d = request.resource.data;
      let groupId = get(/databases/$(database)/documents/users/$(request.auth.uid))
                      .data.get('groupAssignment', '');
      return d.get('studentId', null) == request.auth.uid &&
        d.get('groupSchedule', false) == true &&
        d.get('type', null) == 'lesson' &&
        d.get('reservationType', null) == 'group-lesson' &&
        groupId is string && groupId != '' &&
        d.get('groupId', null) == groupId &&
        d.get('groupAssignment', null) == groupId;
    }

    // Sahibinin yapabildiği TEK değişiklik iptal. Aksi hâlde iptal edilmiş bir
    // kayıt (kilit devredildikten sonra) yeniden 'pending' yapılarak ya da
    // tarihi taşınarak aynı güne ikinci aktif kayıt elde edilebilirdi.
    function isOwnerCancellation() {
      return request.resource.data.get('status', null) == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'cancelledBy']);
    }

    // Reservations collection
    match /reservations/{reservationId} {
      allow read: if request.auth != null;

      // Admin/boss serbest (dersler, elle kayıt, grup senkronu).
      allow create: if request.auth != null &&
        (isAdminOrBoss() ||
         isOwnLockedCourtRental(reservationId) ||
         isOwnGroupLessonSelfHeal());

      allow update: if request.auth != null &&
        ((isReservationOwner() && isOwnerCancellation()) || isAdminOrBoss());

      allow delete: if request.auth != null &&
        (isReservationOwner() || isAdminOrBoss());
    }

    function isValidDayLock(lockId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['studentId', 'dateKey', 'reservationId', 'updatedAt']) &&
        d.get('studentId', null) is string && d.studentId != '' &&
        isValidDateKey(d.get('dateKey', null)) &&
        d.get('reservationId', null) is string && d.reservationId != '' &&
        lockId == d.studentId + '_' + d.dateKey;
    }

    // Öğrencinin kendi kilidi, aynı batch'te yazılan KENDİ rezervasyonuna
    // (aynı gün) bağlanıyor.
    function isOwnDayLockBinding() {
      let d = request.resource.data;
      return d.studentId == request.auth.uid &&
        existsAfter(reservationPath(d.reservationId)) &&
        getAfter(reservationPath(d.reservationId)).data.get('studentId', null) == request.auth.uid &&
        getAfter(reservationPath(d.reservationId)).data.get('dateKey', null) == d.dateKey;
    }

    // Kilidin şu an gösterdiği rezervasyon günü artık tutmuyor mu (yok ya da
    // pending/confirmed değil)? — isDayLockHeld (istemci) paritesi.
    function isDayLockReleased(reservationId) {
      return !exists(reservationPath(reservationId)) ||
        !(get(reservationPath(reservationId)).data.get('status', '') in ['pending', 'confirmed']);
    }

    // Günde-bir kort rezervasyonu kilitleri. Öğrenci kilidini SİLEMEZ — aksi
    // hâlde aktif rezervasyonu dururken kilidi silip ikinci kayıt açabilirdi.
    match /reservationDayLocks/{lockId} {
      allow read: if request.auth != null &&
        ((resource != null && resource.data.get('studentId', null) == request.auth.uid) ||
         isAdminOrBoss());

      allow create: if request.auth != null && isValidDayLock(lockId) &&
        (isOwnDayLockBinding() || isAdminOrBoss());

      allow update: if request.auth != null && isValidDayLock(lockId) &&
        ((isOwnDayLockBinding() && isDayLockReleased(resource.data.get('reservationId', ''))) ||
         isAdminOrBoss());

      allow delete: if isAdminOrBoss();
    }

    // Students collection - admin can read/write, students can read their own
    match /students/{studentId} {
      allow read: if isAuthenticated() &&
        (studentId == request.auth.uid || isAdminOrBoss());
      allow write: if isAdminOrBoss();
    }

    // Attendance collection - Monthly aggregated docs
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrBoss();
    }

    // Attendance Archive collection
    match /attendanceArchive/{archiveId} {
      allow read: if isAuthenticated() &&
        (resource.data.studentId == request.auth.uid || isAdminOrBoss());
      allow write: if isAdminOrBoss();
    }

    // Dues collection - admin/boss can read/write, students can read their own
    match /dues/{dueId} {
      allow read: if isAuthenticated() &&
        (resource.data.studentId == request.auth.uid || isAdminOrBoss());
      allow write: if isAdminOrBoss();
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrBoss();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdminOrBoss();
    }

    // Membership Types collection - all authenticated users can read,
    // admin/boss can write.
    match /membershipTypes/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrBoss();
    }

    // Notifications collection - all authenticated users can read and write for the time being
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // Tournaments — herkes (öğrenci dahil) okur (read-only bracket görünümü),
    // yalnız admin/boss yönetir (oluştur, oyuncu ata, skor gir, karıştır).
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrBoss();
    }
    match /tournamentParticipants/{participantId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrBoss();
    }
    match /tournamentMatches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrBoss();
    }

    // Password resets (geçici şifre) collection — ARTIK KULLANILMIYOR.
    // Geçici şifre atama işi setTempPassword Cloud Function'ına (Admin SDK)
    // taşındı; öğrencinin gerçek Auth şifresi doğrudan güncelleniyor ve geçici
    // şifre Firestore'da düz metin olarak SAKLANMIYOR. Bu koleksiyona client
    // erişimi tamamen kapatıldı (geriye kalan eski dokümanlar için).
    match /passwordResets/{phone} {
      allow read, write: if false;
    }
  }
}